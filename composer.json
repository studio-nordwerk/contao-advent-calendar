{
    "name": "nordwerk/contao-advent-calendar-bundle",
    "description": "Adventskalender für Contao: 24 Türchen mit Angeboten, Gutscheinen oder Geschichten. Der Server prüft das Datum, nichts lässt sich vorab ansehen.",
    "license": "MIT",
    "homepage": "https://www.nordwerk.studio/oss/contao-adventskalender",
    "support": {
        "issues": "https://github.com/studio-nordwerk/contao-advent-calendar/issues",
        "source": "https://github.com/studio-nordwerk/contao-advent-calendar"
    },
    "type": "contao-bundle",
    "keywords": [
        "contao",
        "adventskalender",
        "advent calendar",
        "weihnachten",
        "gutschein"
    ],
    "authors": [
        {
            "name": "Nordwerk",
            "homepage": "https://nordwerk.studio"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/filesystem": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Nordwerk\\AdventCalendarBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Nordwerk\\AdventCalendarBundle\\ContaoManager\\Plugin"
    }
}
