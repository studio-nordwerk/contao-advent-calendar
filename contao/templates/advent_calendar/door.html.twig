{% use '@Contao/component/_figure.html.twig' %}

{#
    Inhalt eines geöffneten Türchens – überschreibbar im Template Studio.
#}

<article class="advent-calendar__door-content">
    {% if door.kicker %}<p class="advent-calendar__kicker">{{ door.kicker }}</p>{% endif %}
    <h2 class="advent-calendar__headline">{{ door.headline }}</h2>

    {% if figure %}
        {% with {figure: figure} %}{{ block('figure_component') }}{% endwith %}
    {% endif %}

    {% if door.text %}
        <div class="advent-calendar__text">{{ door.text|insert_tag|raw }}</div>
    {% endif %}

    {% if door.price %}
        <p class="advent-calendar__price">
            <span class="advent-calendar__price-new">{{ door.price }}</span>
            {% if door.oldPrice %}<s class="advent-calendar__price-old">{{ door.oldPrice }}</s>{% endif %}
        </p>
    {% endif %}

    {% if door.couponCode %}
        <p class="advent-calendar__coupon">
            <span>Ihr Code:</span>
            <button type="button" class="advent-calendar__code" data-copy="{{ door.couponCode }}" title="Code kopieren">{{ door.couponCode }}</button>
        </p>
    {% endif %}

    {% if door.url %}
        <p class="advent-calendar__action">
            <a class="advent-calendar__button" href="{{ door.url|insert_tag }}"{% if door.target %} target="_blank" rel="noopener"{% endif %}>{{ door.linkTitle ?: 'Zum Angebot' }}</a>
        </p>
    {% endif %}
</article>
